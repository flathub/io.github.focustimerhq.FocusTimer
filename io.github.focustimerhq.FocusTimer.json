{
  "app-id": "io.github.focustimerhq.FocusTimer",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "focus-timer",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--system-talk-name=org.freedesktop.login1",
    "--system-talk-name=org.freedesktop.timedate1",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.gnome.Mutter.IdleMonitor",
    "--talk-name=org.gnome.ScreenSaver",
    "--talk-name=org.gnome.Shell",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.mpris.MediaPlayer2.*",
    "--talk-name=org.xfce.ScreenSaver"
  ],
  "cleanup": [
    "/include",
    "/lib/girepository-1.0",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/vala"
  ],
  "modules": [
    {
      "name": "libpeas",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dgjs=false",
        "-Dlua51=false",
        "-Dpython3=false",
        "-Dintrospection=true",
        "-Dvapi=true"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libpeas.git",
          "tag": "2.2.0",
          "commit": "39a2b9c55deaa5246b99b502b53896d3ad41846b"
        }
      ]
    },
    {
      "name": "gom",
      "buildsystem": "meson",
      "builddir": true,
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gom.git",
          "tag": "0.5.5",
          "commit": "0dbeaa81f83ca230d9240be0ff704dc0865a0f1f"
        }
      ]
    },
    {
      "name": "gtk4-layer-shell",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dexamples=false",
        "-Ddocs=false",
        "-Dtests=false",
        "-Dsmoke-tests=false",
        "-Dintrospection=true",
        "-Dvapi=true"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/wmww/gtk4-layer-shell.git",
          "tag": "v1.3.0",
          "commit": "1c963c51514581c41b9bdae08cdf69171265cdda"
        }
      ]
    },
    {
      "name": "focus-timer",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dprofile=default",
        "-Dbuildtype=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/focustimerhq/FocusTimer.git",
          "tag": "1.1.6",
          "commit": "22173b725df37b63a7e67080270c41444bec83ff"
        }
      ]
    }
  ]
}
